# Base de données SQLite (le chemin est relatif au dossier prisma/)
DATABASE_URL="file:./db.sqlite"

# Secret utilisé pour signer les tokens JWT : remplacez-le par une valeur longue et aléatoire
JWT_SECRET="changez-moi"
JWT_EXPIRES_IN="7d"

PORT=8000
NODE_ENV=development

# Origines autorisées à appeler l'API (front-end), séparées par des virgules
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
